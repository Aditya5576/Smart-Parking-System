# ======================================================
# .gitignore - Files to NEVER commit to GitHub
# ======================================================

# Environment variables - contains secret keys!
# NEVER push this to GitHub
backend/.env
.env

# Node dependencies - too large, reinstalled via npm install
node_modules/
backend/node_modules/

# Compiled C++ engine binary
engine/*.exe
engine/*.o

# OS junk files
.DS_Store
Thumbs.db

# Stray git file at root
/git
